+# starts ani-tracker next to mpv: Discord Rich Presence + AniList progress sync.
+# sets ipc_flag, which the mpv command line passes on
+start_tracker() {
+    unset ipc_flag
+    [ -n "$tracker_exe" ] || return 0
+    [ "$discord_presence" = 0 ] && [ "$anilist_sync" = 0 ] && return 0
+    _ipc_sock="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/ani-cli-$$-$(date +%s).sock"
+    ipc_flag="--input-ipc-server=$_ipc_sock"
+    _tracker_flags=""
+    [ "$discord_presence" = 0 ] && _tracker_flags="--no-discord"
+    [ "$anilist_sync" = 0 ] && _tracker_flags="$_tracker_flags --no-anilist"
+    # shellcheck disable=SC2086
+    nohup "$tracker_exe" --socket "$_ipc_sock" --mal-id "${mal_id:-0}" --episode "$ep_no" --title "$anime_title" $_tracker_flags >/dev/null 2>&1 &
+}
